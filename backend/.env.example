# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── OpenAI (GPT-4o Vision) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Twilio (SMS) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # Your Twilio phone number
GISELLE_PHONE_NUMBER=+1XXXXXXXXXX # Giselle's mobile number

# ── Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_BASE_URL=https://your-vercel-deployment.vercel.app

# ── Google Ads Offline Conversions ───────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CUSTOMER_ID=123-456-7890          # Your Google Ads account ID (no dashes in API calls)
GOOGLE_ADS_CONVERSION_ACTION_ID=your_action_id
GOOGLE_ADS_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=your_refresh_token
