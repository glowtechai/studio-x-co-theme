<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lato:wght@300;400;500;700&display=swap');

.sxa {
  --gold: #C49C5C;
  --gold-light: #E8C98A;
  --gold-dim: rgba(196,156,92,0.13);
  --gold-border: rgba(196,156,92,0.22);
  --gold-active: rgba(196,156,92,0.55);
  --bg: #09080A;
  --surface: #100F14;
  --card: #17151D;
  --card-hover: #1E1B26;
  --cream: #F0EBE0;
  --muted: #7A7485;
  --serif: 'Playfair Display', Georgia, serif;
  --sans: 'Lato', -apple-system, sans-serif;
  background: var(--bg);
  color: var(--cream);
  font-family: var(--sans);
  min-height: 100vh;
  padding: 0;
  margin: 0;
}

.sxa *, .sxa *::before, .sxa *::after { box-sizing: border-box; }

/* ── HEADER ── */
.sxa__header {
  text-align: center;
  padding: 52px 24px 20px;
  border-bottom: 1px solid var(--gold-border);
}
.sxa__logo {
  font-family: var(--serif);
  font-size: 13px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 4px;
}
.sxa__tagline {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
}

/* ── PROGRESS ── */
.sxa__progress {
  padding: 28px 40px 0;
  max-width: 640px;
  margin: 0 auto;
  display: none;
}
.sxa__progress.is-visible { display: block; }
.sxa__progress-track {
  height: 1px;
  background: var(--gold-border);
  border-radius: 1px;
  position: relative;
  margin-bottom: 12px;
}
.sxa__progress-fill {
  height: 1px;
  background: linear-gradient(90deg, var(--gold), var(--gold-light));
  border-radius: 1px;
  transition: width 0.5s ease;
}
.sxa__progress-dots {
  display: flex;
  justify-content: space-between;
}
.sxa__progress-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--gold-border);
  border: 1px solid var(--gold-border);
  transition: all 0.3s;
}
.sxa__progress-dot.is-done { background: var(--gold); border-color: var(--gold); }
.sxa__progress-dot.is-active {
  background: transparent;
  border-color: var(--gold-light);
  box-shadow: 0 0 6px var(--gold);
}
.sxa__progress-label {
  text-align: center;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: 14px;
}

/* ── STEPS ── */
.sxa__step { display: none; animation: sxaFadeIn 0.45s ease; }
.sxa__step.is-active { display: block; }
@keyframes sxaFadeIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

.sxa__inner {
  max-width: 700px;
  margin: 0 auto;
  padding: 48px 24px 80px;
}

/* ── TYPOGRAPHY ── */
.sxa__eyebrow {
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.sxa__h1 {
  font-family: var(--serif);
  font-size: clamp(32px, 5vw, 52px);
  font-weight: 400;
  line-height: 1.15;
  margin: 0 0 20px;
  color: var(--cream);
}
.sxa__h1 em { font-style: italic; color: var(--gold-light); }
.sxa__h2 {
  font-family: var(--serif);
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 400;
  line-height: 1.2;
  margin: 0 0 14px;
  color: var(--cream);
}
.sxa__h2 em { font-style: italic; color: var(--gold-light); }
.sxa__lead {
  font-size: 16px;
  line-height: 1.7;
  color: #BDB5A8;
  margin-bottom: 40px;
  max-width: 580px;
}
.sxa__lead strong { color: var(--cream); font-weight: 500; }
.sxa__divider {
  width: 48px; height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  margin: 28px auto;
}

/* ── WELCOME ── */
.sxa__welcome {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60px 24px;
}
.sxa__welcome .sxa__h1 { font-size: clamp(36px, 6vw, 64px); }
.sxa__welcome .sxa__lead { margin: 0 auto 44px; text-align: center; }
.sxa__badge {
  display: inline-block;
  border: 1px solid var(--gold-border);
  padding: 7px 20px;
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 36px;
}

/* ── BUTTONS ── */
.sxa__btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 40px;
  background: linear-gradient(135deg, #C49C5C, #B08640);
  color: #0A0806;
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: all 0.25s;
  text-decoration: none;
}
.sxa__btn:hover { background: linear-gradient(135deg, #D4AE6C, #C49C5C); transform: translateY(-1px); }
.sxa__btn--ghost {
  background: transparent;
  border: 1px solid var(--gold-border);
  color: var(--muted);
  padding: 14px 32px;
}
.sxa__btn--ghost:hover { border-color: var(--gold); color: var(--gold); transform: none; }
.sxa__btn-arrow { font-size: 18px; }

.sxa__nav {
  display: flex;
  gap: 14px;
  align-items: center;
  margin-top: 40px;
  flex-wrap: wrap;
}

/* ── SERVICE CARDS ── */
.sxa__services {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
  margin: 32px 0;
}
.sxa__service-card {
  background: var(--card);
  border: 1px solid var(--gold-border);
  padding: 28px 24px;
  cursor: pointer;
  transition: all 0.25s;
  position: relative;
}
.sxa__service-card:hover {
  border-color: var(--gold);
  background: var(--card-hover);
}
.sxa__service-card.is-selected {
  border-color: var(--gold);
  background: var(--gold-dim);
}
.sxa__service-card.is-selected::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}
.sxa__service-check {
  position: absolute;
  top: 16px; right: 16px;
  width: 20px; height: 20px;
  border: 1px solid var(--gold-border);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px;
  color: transparent;
  transition: all 0.2s;
}
.sxa__service-card.is-selected .sxa__service-check {
  background: var(--gold);
  border-color: var(--gold);
  color: #0A0806;
}
.sxa__service-tag {
  font-size: 9px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 10px;
}
.sxa__service-name {
  font-family: var(--serif);
  font-size: 20px;
  font-weight: 500;
  margin-bottom: 10px;
  color: var(--cream);
}
.sxa__service-desc {
  font-size: 14px;
  line-height: 1.65;
  color: #9A9090;
}
.sxa__service-card.is-selected .sxa__service-desc { color: #BDB5A8; }
.sxa__service-ideal {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--gold-border);
  font-size: 12px;
  color: var(--gold);
  font-style: italic;
}

.sxa__skip-note {
  font-size: 13px;
  color: var(--muted);
  margin-top: 8px;
}

/* ── CHOICE GRIDS ── */
.sxa__question { margin-bottom: 36px; }
.sxa__qlabel {
  font-family: var(--serif);
  font-size: 18px;
  font-weight: 400;
  margin-bottom: 16px;
  color: var(--cream);
}
.sxa__qlabel em { font-style: italic; color: var(--gold-light); }
.sxa__choices {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.sxa__choice {
  padding: 11px 20px;
  border: 1px solid var(--gold-border);
  background: var(--card);
  font-size: 13px;
  color: #BDB5A8;
  cursor: pointer;
  transition: all 0.2s;
  user-select: none;
  letter-spacing: 0.02em;
}
.sxa__choice:hover { border-color: var(--gold); color: var(--cream); }
.sxa__choice.is-selected {
  border-color: var(--gold);
  background: var(--gold-dim);
  color: var(--cream);
}
.sxa__choices--grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
}
.sxa__choices--grid .sxa__choice {
  text-align: center;
  padding: 16px 12px;
}
.sxa__choice-icon {
  display: block;
  font-size: 22px;
  margin-bottom: 7px;
}
.sxa__choice-label { display: block; font-size: 13px; }
.sxa__choice-sub { display: block; font-size: 11px; color: var(--muted); margin-top: 3px; }

.sxa__textarea {
  width: 100%;
  background: var(--card);
  border: 1px solid var(--gold-border);
  color: var(--cream);
  font-family: var(--sans);
  font-size: 14px;
  line-height: 1.6;
  padding: 16px 18px;
  resize: vertical;
  min-height: 120px;
  transition: border-color 0.2s;
  outline: none;
}
.sxa__textarea::placeholder { color: var(--muted); }
.sxa__textarea:focus { border-color: var(--gold); }

/* ── PRICING ── */
.sxa__pricing-intro {
  background: var(--card);
  border: 1px solid var(--gold-border);
  border-left: 3px solid var(--gold);
  padding: 20px 24px;
  margin-bottom: 32px;
  font-size: 14px;
  line-height: 1.7;
  color: #BDB5A8;
}
.sxa__tiers {
  display: grid;
  gap: 16px;
  margin-bottom: 32px;
}
.sxa__tier {
  background: var(--card);
  border: 1px solid var(--gold-border);
  padding: 28px 28px 24px;
  position: relative;
  overflow: hidden;
}
.sxa__tier--featured { border-color: var(--gold); }
.sxa__tier--featured::after {
  content: 'Most Popular';
  position: absolute;
  top: 18px; right: 0;
  background: var(--gold);
  color: #0A0806;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 4px 14px;
}
.sxa__tier-name {
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 500;
  margin-bottom: 8px;
  color: var(--cream);
}
.sxa__tier-price {
  font-size: 13px;
  color: var(--gold);
  letter-spacing: 0.05em;
  margin-bottom: 12px;
}
.sxa__tier-price strong { font-size: 28px; font-weight: 300; font-family: var(--serif); }
.sxa__tier-desc {
  font-size: 13px;
  color: #9A9090;
  line-height: 1.6;
}
.sxa__tier-items {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--gold-border);
  list-style: none;
  padding-left: 0;
}
.sxa__tier-items li {
  font-size: 12px;
  color: #9A9090;
  padding: 3px 0 3px 18px;
  position: relative;
}
.sxa__tier-items li::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--gold);
  font-size: 11px;
}
.sxa__pricing-note {
  font-size: 13px;
  color: var(--muted);
  text-align: center;
  font-style: italic;
  line-height: 1.6;
}

/* ── CONTACT FIELDS ── */
.sxa__fields { display: grid; gap: 16px; }
.sxa__fields--2col { grid-template-columns: 1fr 1fr; }
@media (max-width: 540px) { .sxa__fields--2col { grid-template-columns: 1fr; } }
.sxa__field { display: flex; flex-direction: column; gap: 8px; }
.sxa__field-label {
  font-size: 10px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
}
.sxa__field-label span { color: var(--muted); font-size: 9px; margin-left: 4px; }
.sxa__input, .sxa__select {
  background: var(--card);
  border: 1px solid var(--gold-border);
  color: var(--cream);
  font-family: var(--sans);
  font-size: 14px;
  padding: 13px 16px;
  outline: none;
  transition: border-color 0.2s;
  width: 100%;
  appearance: none;
  -webkit-appearance: none;
}
.sxa__input::placeholder { color: var(--muted); }
.sxa__input:focus, .sxa__select:focus { border-color: var(--gold); }
.sxa__input--prefix { padding-left: 30px; }
.sxa__field-wrap { position: relative; }
.sxa__field-prefix {
  position: absolute;
  left: 14px; top: 50%;
  transform: translateY(-50%);
  color: var(--gold);
  font-size: 15px;
  pointer-events: none;
}
.sxa__select-wrap { position: relative; }
.sxa__select-wrap::after {
  content: '▾';
  position: absolute;
  right: 14px; top: 50%;
  transform: translateY(-50%);
  color: var(--gold);
  pointer-events: none;
  font-size: 12px;
}
.sxa__select option { background: #1C1820; }

/* ── PHOTO UPLOAD ── */
.sxa__upload-section { margin-top: 32px; }
.sxa__upload-label {
  font-size: 10px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 12px;
  display: block;
}
.sxa__upload-note {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 16px;
  line-height: 1.5;
}
.sxa__upload-zone {
  border: 1px dashed var(--gold-border);
  background: var(--card);
  padding: 36px 24px;
  text-align: center;
  cursor: pointer;
  transition: all 0.25s;
  position: relative;
}
.sxa__upload-zone:hover, .sxa__upload-zone.is-drag { border-color: var(--gold); background: var(--gold-dim); }
.sxa__upload-zone input[type="file"] {
  position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
}
.sxa__upload-icon { font-size: 32px; margin-bottom: 10px; opacity: 0.5; }
.sxa__upload-text { font-size: 13px; color: #9A9090; line-height: 1.5; }
.sxa__upload-text strong { color: var(--gold); font-weight: 400; }
.sxa__upload-previews {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 14px;
}
.sxa__upload-preview {
  aspect-ratio: 1;
  background: var(--card);
  border: 1px solid var(--gold-border);
  overflow: hidden;
  position: relative;
}
.sxa__upload-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sxa__upload-preview-label {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: rgba(9,8,10,0.8);
  font-size: 10px;
  color: var(--gold);
  padding: 5px 8px;
  text-align: center;
  letter-spacing: 0.1em;
}
.sxa__upload-remove {
  position: absolute; top: 5px; right: 5px;
  width: 20px; height: 20px;
  background: rgba(9,8,10,0.85);
  border: none;
  color: var(--cream);
  cursor: pointer;
  font-size: 12px;
  display: flex; align-items: center; justify-content: center;
}

/* ── CONFIRMATION ── */
.sxa__confirm {
  text-align: center;
  padding: 80px 24px;
  max-width: 600px;
  margin: 0 auto;
}
.sxa__confirm-icon { font-size: 48px; margin-bottom: 28px; opacity: 0.8; }
.sxa__confirm-hr {
  width: 60px; height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  margin: 28px auto;
}
.sxa__confirm-body {
  font-size: 16px;
  line-height: 1.8;
  color: #BDB5A8;
  margin-bottom: 32px;
}
.sxa__confirm-body strong { color: var(--cream); font-weight: 500; }
.sxa__confirm-social {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 32px;
}
.sxa__confirm-social a {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  text-decoration: none;
  border-bottom: 1px solid var(--gold-border);
  padding-bottom: 2px;
  transition: color 0.2s;
}
.sxa__confirm-social a:hover { color: var(--gold-light); }

/* ── VALIDATION ── */
.sxa__error {
  color: #C07070;
  font-size: 12px;
  margin-top: 6px;
  display: none;
}
.sxa__error.is-visible { display: block; }
.sxa__input.is-invalid, .sxa__select.is-invalid { border-color: #C07070; }

@media (max-width: 600px) {
  .sxa__inner { padding: 36px 18px 60px; }
  .sxa__progress { padding: 20px 24px 0; }
  .sxa__services { grid-template-columns: 1fr; }
}
</style>

{%- form 'contact', id: 'SxaAssessmentForm' -%}

{%- if form.posted_successfully? -%}
<div class="sxa">
  <div class="sxa__header">
    <div class="sxa__logo">The Studio X Co.</div>
    <div class="sxa__tagline">Luxury Hair Extensions · Downey, CA</div>
  </div>
  <div class="sxa__confirm">
    <div class="sxa__confirm-icon">✦</div>
    <div class="sxa__eyebrow">Assessment Received</div>
    <h1 class="sxa__h1">You're One Step Closer to <em>Your Best Hair</em></h1>
    <div class="sxa__confirm-hr"></div>
    <p class="sxa__confirm-body">
      Thank you for trusting The Studio X Co. with your hair journey.<br><br>
      <strong>Giselle will personally review your assessment</strong> and reach out to you within <strong>24–48 hours</strong> to discuss your goals and recommend the perfect method for your hair.<br><br>
      In the meantime, feel free to browse our work and send your hair photos directly via Instagram DM.
    </p>
    <div class="sxa__confirm-social">
      <a href="https://www.instagram.com/thestudioxco" target="_blank">@thestudioxco</a>
    </div>
  </div>
</div>

{%- else -%}

<div class="sxa" id="sxaRoot">
  <div class="sxa__header">
    <div class="sxa__logo">The Studio X Co.</div>
    <div class="sxa__tagline">Luxury Hair Extensions · Downey, CA</div>
  </div>

  <!-- Progress Bar -->
  <div class="sxa__progress" id="sxaProgress">
    <div class="sxa__progress-track">
      <div class="sxa__progress-fill" id="sxaFill" style="width:0%"></div>
    </div>
    <div class="sxa__progress-dots" id="sxaDots">
      <div class="sxa__progress-dot" data-dot="1"></div>
      <div class="sxa__progress-dot" data-dot="2"></div>
      <div class="sxa__progress-dot" data-dot="3"></div>
      <div class="sxa__progress-dot" data-dot="4"></div>
      <div class="sxa__progress-dot" data-dot="5"></div>
    </div>
    <div class="sxa__progress-label" id="sxaStepLabel">Step 1 of 5</div>
  </div>

  <!-- ── STEP 0: WELCOME ── -->
  <div class="sxa__step is-active" data-step="0">
    <div class="sxa__welcome">
      <div class="sxa__badge">Virtual Hair Assessment</div>
      <div class="sxa__eyebrow">The Studio X Co.</div>
      <h1 class="sxa__h1">Your Most Beautiful<br><em>Hair Starts Here</em></h1>
      <div class="sxa__divider"></div>
      <p class="sxa__lead">
        You deserve hair that moves with confidence — full, natural, and entirely yours. This guided assessment takes just a few minutes and helps Giselle create a personalized recommendation tailored to <strong>your hair, your lifestyle, and your goals.</strong>
      </p>
      <button type="button" class="sxa__btn" onclick="sxaGoTo(1)">
        Begin Your Assessment <span class="sxa__btn-arrow">→</span>
      </button>
    </div>
  </div>

  <!-- ── STEP 1: DISCOVER YOUR METHOD ── -->
  <div class="sxa__step" data-step="1">
    <div class="sxa__inner">
      <div class="sxa__eyebrow">Step 1 · Your Method</div>
      <h2 class="sxa__h2">Discover What's <em>Possible</em></h2>
      <p class="sxa__lead">Each of our methods is designed with a specific hair type and goal in mind. Read through and select the ones that spark your interest — it's okay to choose more than one, or simply say "not sure yet."</p>

      <div class="sxa__services" id="sxaServices">
        <div class="sxa__service-card" data-service="ktip" onclick="sxaToggleService(this)">
          <div class="sxa__service-check">✓</div>
          <div class="sxa__service-tag">Individual Bond Method</div>
          <div class="sxa__service-name">K-Tip Extensions</div>
          <div class="sxa__service-desc">Individual strands fused one-by-one using a keratin protein bond — the gold standard for natural movement and undetectable blending. Bonds lay perfectly flush for ponytails and updos.</div>
          <div class="sxa__service-ideal">Ideal for: adding length and volume, active lifestyles</div>
        </div>
        <div class="sxa__service-card" data-service="microktip" onclick="sxaToggleService(this)">
          <div class="sxa__service-check">✓</div>
          <div class="sxa__service-tag">Fine Hair Specialist</div>
          <div class="sxa__service-name">Micro K-Tip Extensions</div>
          <div class="sxa__service-desc">The same precision bond method — scaled down for finer, more delicate strands. The featherweight micro-bond distributes weight evenly, so your hair moves freely and feels completely natural.</div>
          <div class="sxa__service-ideal">Ideal for: fine or fragile hair, lightweight feel</div>
        </div>
        <div class="sxa__service-card" data-service="mesh" onclick="sxaToggleService(this)">
          <div class="sxa__service-check">✓</div>
          <div class="sxa__service-tag">Thinning Specialist</div>
          <div class="sxa__service-name">Mesh Integration</div>
