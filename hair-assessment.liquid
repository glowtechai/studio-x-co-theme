<script>
(function() {
  var current = 0;
  var answers = {};

  function goTo(step) {
    var steps = document.querySelectorAll('.sxa__step');
    steps.forEach(function(s) { s.classList.remove('is-active'); });
    var target = document.querySelector('[data-step="' + step + '"]');
    if (target) {
      target.classList.add('is-active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    current = step;
    updateProgress(step);
  }

  function updateProgress(step) {
    var prog = document.getElementById('sxaProgress');
    var fill = document.getElementById('sxaFill');
    var label = document.getElementById('sxaStepLabel');
    if (!prog) return;

    if (step === 0 || step >= 6) {
      prog.classList.remove('is-visible');
      return;
    }
    prog.classList.add('is-visible');

    var pct = ((step - 1) / 4) * 100;
    if (step === 5) pct = 100;
    fill.style.width = pct + '%';

    var dots = document.querySelectorAll('.sxa__progress-dot');
    dots.forEach(function(d, i) {
      var n = i + 1;
      d.classList.remove('is-done', 'is-active');
      if (n < step) d.classList.add('is-done');
      else if (n === step) d.classList.add('is-active');
    });

    if (label) label.textContent = 'Step ' + step + ' of 5';
  }

  function collectChoices(step) {
    var container = document.querySelector('[data-step="' + step + '"]');
    if (!container) return;
    var groups = container.querySelectorAll('[data-field]');
    groups.forEach(function(group) {
      var field = group.getAttribute('data-field');
      var multi = group.getAttribute('data-multi') === 'true';
      if (group.tagName === 'TEXTAREA') {
        answers[field] = group.value.trim();
      } else {
        var selected = Array.from(group.querySelectorAll('.sxa__choice.is-selected'))
          .map(function(c) { return c.getAttribute('data-val'); });
        answers[field] = multi ? selected.join(', ') : (selected[0] || '');
      }
    });
  }

  function validateStep(step) {
    var valid = true;
    var container = document.querySelector('[data-step="' + step + '"]');
    if (!container) return true;

    var required = container.querySelectorAll('[data-required="true"]');
    required.forEach(function(group) {
      var field = group.getAttribute('data-field');
      var selected = group.querySelectorAll('.sxa__choice.is-selected');
      var errEl = document.getElementById('err-' + field);
      if (selected.length === 0) {
        if (errEl) errEl.classList.add('is-visible');
        valid = false;
      } else {
        if (errEl) errEl.classList.remove('is-visible');
      }
    });

    if (step === 5) {
      var first = document.getElementById('sxa-first');
      var email = document.getElementById('sxa-email');
      var phone = document.getElementById('sxa-phone');
      var found = document.getElementById('sxa-found');

      if (!first || !first.value.trim()) {
        var e = document.getElementById('err-first');
        if (e) e.classList.add('is-visible');
        if (first) first.classList.add('is-invalid');
        valid = false;
      } else {
        var e = document.getElementById('err-first');
        if (e) e.classList.remove('is-visible');
        if (first) first.classList.remove('is-invalid');
      }

      var emailVal = email ? email.value.trim() : '';
      var emailOk = emailVal && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal);
      if (!emailOk) {
        var e = document.getElementById('err-email');
        if (e) e.classList.add('is-visible');
        if (email) email.classList.add('is-invalid');
        valid = false;
      } else {
        var e = document.getElementById('err-email');
        if (e) e.classList.remove('is-visible');
        if (email) email.classList.remove('is-invalid');
      }

      if (!phone || !phone.value.trim()) {
        var e = document.getElementById('err-phone');
        if (e) e.classList.add('is-visible');
        if (phone) phone.classList.add('is-invalid');
        valid = false;
      } else {
        var e = document.getElementById('err-phone');
        if (e) e.classList.remove('is-visible');
        if (phone) phone.classList.remove('is-invalid');
      }

      if (!found || !found.value) {
        var e = document.getElementById('err-found');
        if (e) e.classList.add('is-visible');
        if (found) found.classList.add('is-invalid');
        valid = false;
      } else {
        var e = document.getElementById('err-found');
        if (e) e.classList.remove('is-visible');
        if (found) found.classList.remove('is-invalid');
      }
    }

    return valid;
  }

  window.sxaGoTo = goTo;

  window.sxaNext = function(fromStep) {
    collectChoices(fromStep);
    if (!validateStep(fromStep)) return;
    goTo(fromStep + 1);
  };

  window.sxaToggleService = function(card) {
    card.classList.toggle('is-selected');
  };

  // Thinning cause show/hide
  document.addEventListener('click', function(e) {
    var choice = e.target.closest('.sxa__choice');
    if (!choice) return;
    var group = choice.closest('[data-field]');
    if (!group) return;
    var multi = group.getAttribute('data-multi') === 'true';
    if (!multi) {
      group.querySelectorAll('.sxa__choice').forEach(function(c) { c.classList.remove('is-selected'); });
    }
    choice.classList.toggle('is-selected');

    // Show thinning cause if thinning = yes
    var trigger = group.getAttribute('data-trigger');
    if (trigger) {
      var el = document.getElementById(trigger);
      if (el) {
        var val = choice.getAttribute('data-val');
        var show = choice.classList.contains('is-selected') && (val === 'Yes, noticeably' || val === 'Some changes');
        el.style.display = show ? 'block' : 'none';
      }
    }

    // Clear required error on selection
    var field = group.getAttribute('data-field');
    var errEl = document.getElementById('err-' + field);
    if (errEl && group.querySelectorAll('.sxa__choice.is-selected').length > 0) {
      errEl.classList.remove('is-visible');
    }
  });

  // Referral field show/hide
  var foundSel = document.getElementById('sxa-found');
  if (foundSel) {
    foundSel.addEventListener('change', function() {
      var wrap = document.getElementById('sxa-referral-wrap');
      if (wrap) wrap.style.display = this.value === 'Friend or Family Referral' ? 'block' : 'none';
    });
  }

  // Photo upload
  var photoInput = document.getElementById('sxaPhotoInput');
  var previews = document.getElementById('sxaPreviews');
  var dropZone = document.getElementById('sxaDropZone');
  var photoFiles = [];
  var PHOTO_LABELS = ['Top of Head', 'Side View', 'Area of Concern'];

  function renderPreviews() {
    if (!previews) return;
    previews.innerHTML = '';
    if (photoFiles.length === 0) { previews.style.display = 'none'; return; }
    previews.style.display = 'grid';
    photoFiles.forEach(function(file, i) {
      var reader = new FileReader();
      reader.onload = function(ev) {
        var div = document.createElement('div');
        div.className = 'sxa__upload-preview';
        div.innerHTML = '<img src="' + ev.target.result + '" alt="Hair photo ' + (i+1) + '">'
          + '<div class="sxa__upload-preview-label">' + (PHOTO_LABELS[i] || 'Photo ' + (i+1)) + '</div>'
          + '<button type="button" class="sxa__upload-remove" data-idx="' + i + '">✕</button>';
        previews.appendChild(div);
      };
      reader.readAsDataURL(file);
    });
  }

  if (photoInput) {
    photoInput.addEventListener('change', function() {
      var newFiles = Array.from(this.files).slice(0, 3 - photoFiles.length);
      photoFiles = photoFiles.concat(newFiles).slice(0, 3);
      renderPreviews();
      this.value = '';
    });
  }

  if (previews) {
    previews.addEventListener('click', function(e) {
      var btn = e.target.closest('.sxa__upload-remove');
      if (!btn) return;
      var idx = parseInt(btn.getAttribute('data-idx'), 10);
      photoFiles.splice(idx, 1);
      renderPreviews();
    });
  }

  if (dropZone) {
    dropZone.addEventListener('dragover', function(e) { e.preventDefault(); this.classList.add('is-drag'); });
    dropZone.addEventListener('dragleave', function() { this.classList.remove('is-drag'); });
    dropZone.addEventListener('drop', function(e) {
      e.preventDefault();
      this.classList.remove('is-drag');
      var dropped = Array.from(e.dataTransfer.files).filter(function(f) { return f.type.startsWith('image/'); });
      photoFiles = photoFiles.concat(dropped).slice(0, 3);
      renderPreviews();
    });
  }

  window.sxaPrepareSubmit = function() {
    collectChoices(2);
    collectChoices(3);

    // Collect services
    var serviceCards = document.querySelectorAll('.sxa__service-card.is-selected');
    var services = Array.from(serviceCards).map(function(c) { return c.querySelector('.sxa__service-name').textContent.trim(); });
    var serviceHidden = document.getElementById('sxaHiddenService');
    if (serviceHidden) serviceHidden.value = services.length ? services.join(', ') : 'Not yet selected';

    // Collect first+last name into contact[name]
    var first = document.getElementById('sxa-first');
    var last = document.getElementById('sxa-last');
    // Build full summary body
    var lines = [
      '═══════════════════════════════════════',
      'THE STUDIO X CO — VIRTUAL HAIR ASSESSMENT',
      '═══════════════════════════════════════',
      '',
      '── SERVICE INTEREST ──',
      'Method(s) of Interest: ' + (services.length ? services.join(', ') : 'Not yet selected'),
      '',
      '── HAIR ASSESSMENT ──',
      'Current Density: ' + (answers.density || '—'),
      'Current Length: ' + (answers.length || '—'),
      'Areas of Concern: ' + (answers.areas || '—'),
      'Experiencing Thinning: ' + (answers.thinning || '—'),
      'Possible Cause: ' + (answers.thinning_cause || '—'),
      '',
      '── LIFESTYLE & GOALS ──',
      'Lifestyle: ' + (answers.lifestyle || '—'),
      'Heat Styling: ' + (answers.heat_styling || '—'),
      'Primary Goal: ' + (answers.goal || '—'),
      'Maintenance Preference: ' + (answers.maintenance || '—'),
      '',
      '── NOTES ──',
      answers.notes || '(No additional notes)',
      '',
      '── PHOTOS ──',
      photoFiles.length > 0
        ? 'Client uploaded ' + photoFiles.length + ' photo(s). Check Instagram DM for hair photos.'
        : 'No photos uploaded — remind client to DM photos to @thestudioxco',
      '',
      '═══════════════════════════════════════'
    ];
    var bodyHidden = document.getElementById('sxaHiddenBody');
    if (bodyHidden) bodyHidden.value = lines.join('\n');
  };

})();
</script>

